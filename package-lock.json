{
  "name": "kym",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "kym",
      "version": "0.1.0",
      "workspaces": [
        "packages/contract",
        "packages/engine",
        "cli"
      ]
    },
    "cli": {
      "name": "@kym/cli",
      "version": "0.1.0",
      "dependencies": {
        "@kym/contract": "file:../packages/contract",
        "@kym/engine": "file:../packages/engine"
      },
      "bin": {
        "kym-demo": "demo.mjs"
      }
    },
    "node_modules/@kym/cli": {
      "resolved": "cli",
      "link": true
    },
    "node_modules/@kym/contract": {
      "resolved": "packages/contract",
      "link": true
    },
    "node_modules/@kym/engine": {
      "resolved": "packages/engine",
      "link": true
    },
    "packages/contract": {
      "name": "@kym/contract",
      "version": "0.1.0"
    },
    "packages/engine": {
      "name": "@kym/engine",
      "version": "0.1.0",
      "dependencies": {
        "@kym/contract": "file:../contract"
      }
    }
  }
}
