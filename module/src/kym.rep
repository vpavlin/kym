// View contract for the KYM budget module. QML gets a typed replica via
// logos.module("kym"): PROPs auto-sync, SLOTs are callable (async).
// Amounts are passed as human strings ("10.50") and parsed to integer
// milliunits in the backend — money never rides as a float. SLOTs return ""
// on success, or an error string.
class Kym
{
    // Bootstrap → ready status line for the header.
    PROP(QString status="Starting…" READONLY)

    // True once the backend has folded an initial budget.
    PROP(bool ready=false READONLY)

    // 3-word pairing fingerprint (pgp words) of the household secret — shown so
    // devices can confirm they share the same key. NOT the secret/topic.
    PROP(QString fingerprint="" READONLY)

    // The folded BudgetState as JSON — the whole view renders off this:
    // { currentMonth, readyToAssign, invariant:{ok,assets,categoriesAvail},
    //   accounts:[{id,name,type,onBudget,balance}],
    //   groups:[{id,name,categories:[{id,name,assigned,activity,available,negative}]}],
    //   creditCardPayments:[{account,name,available}] }
    PROP(QString budgetJson="{}" READONLY)

    // Seed a realistic sample budget (accounts, categories, income, spending).
    SLOT(QString loadDemo())

    // Re-broadcast the whole local event log over Delivery — backfill for a peer
    // (phone / another Basecamp) that just joined and missed live events.
    SLOT(QString resync())

    // Open an account. type ∈ checking|savings|cash|creditCard|lineOfCredit|tracking.
    SLOT(QString addAccount(QString name, QString type, QString balance))

    // Create a category under a (created-on-demand) group.
    SLOT(QString addCategory(QString name, QString group))

    // Assign (delta) money to a category for a month (YYYY-MM, empty = current).
    SLOT(QString assign(QString category, QString month, QString amount))

    // Record spending: an outflow from an account, charged to a category.
    SLOT(QString spend(QString amount, QString account, QString category))

    // Record income: an inflow to an account, landing in Ready to Assign.
    SLOT(QString income(QString amount, QString account))

    // Set a category funding target. type ∈ monthly|balance|balanceByDate.
    SLOT(QString setTarget(QString category, QString targetType, QString amount, QString month))

    // Reconcile an account to its real (bank) balance; books an uncategorized
    // adjustment (→ Ready to Assign) when KYM and the bank differ.
    SLOT(QString reconcile(QString account, QString actual))

    // Move budgeted money between two categories (net-zero) for a month.
    SLOT(QString moveMoney(QString fromCategory, QString toCategory, QString month, QString amount))
}
