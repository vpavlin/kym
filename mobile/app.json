{
  "expo": {
    "name": "KYM",
    "slug": "kym",
    "version": "0.14.17",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "kym",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2e333a"
    },
    "experiments": {
      "onDemandFilesystem": false
    },
    "android": {
      "package": "co.logos.kym",
      "versionCode": 43,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-bg.png",
        "backgroundColor": "#2e333a"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.logos.kym"
    },
    "plugins": [
      "./plugins/withReleaseSigning",
      "./plugins/withLogosDelivery",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "KYM scans the pairing QR shown by another household device."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "KYM scans your receipt to prefill the amount.",
          "photosPermission": "KYM reads a receipt photo to prefill the amount."
        }
      ]
    ]
  }
}
